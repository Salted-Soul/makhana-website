# ======================================
# SERVER
# ======================================
PORT=5000
NODE_ENV=development
DEBUG=true


# ======================================
# CLIENT
# ======================================
CLIENT_URL=http://localhost:5500
FRONTEND_URL=http://localhost:5500
API_URL=https://consoling-backspace-elongated.ngrok-free.dev


# ======================================
# DATABASE
# ======================================
MONGO_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@cluster.mongodb.net/YOUR_DATABASE_NAME?retryWrites=true&w=majority


# ======================================
# JWT AUTH
# ======================================
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_64_CHARACTER_SECRET
JWT_EXPIRES_IN=7d


# ======================================
# COOKIE SECURITY
# ======================================
COOKIE_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET


# ======================================
# PASSWORD HASHING
# ======================================
BCRYPT_ROUNDS=12


# ======================================
# RAZORPAY
# ======================================
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET


# ======================================
# EMAIL SYSTEM
# ======================================
EMAIL_FROM=no-reply@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password


# ======================================
# RESEND EMAIL API (OPTIONAL)
# ======================================
RESEND_API_KEY=


# ======================================
# TWILIO / WHATSAPP
# ======================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# ======================================
# META WHATSAPP CLOUD API
# ======================================
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=


# ======================================
# GOOGLE AUTH
# ======================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ======================================
# ADMIN
# ======================================
ADMIN_EMAIL=admin@example.com


# ======================================
# LOGGING
# ======================================
LOG_LEVEL=debug


# ======================================
# ERROR TRACKING
# ======================================
SENTRY_DSN=


# ======================================
# REDIS (FUTURE SCALING)
# ======================================
REDIS_URL=


# ======================================
# CLOUDINARY (FUTURE IMAGE STORAGE)
# ======================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=